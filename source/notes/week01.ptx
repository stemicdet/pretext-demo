    <theorem xml:id="thm-pythagorean">
      <title>Pythagorean Theorem</title>
      
      
      <statement>
        <p>
          For a right triangle with sides <m>a</m> and <m>b</m> and hypotenuse <m>c</m>, 
          <md>
            a^2+b^2=c^2
          </md>
          
        </p>
      </statement>
    </theorem>
    
