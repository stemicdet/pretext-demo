<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Homework 3 (Due September 10)</title>
  <introduction>
    <p>
      <alert>Instructions:</alert> Complete all the exercises below and submit your work by the due date.
    </p>
  </introduction>

  <page>
    <exercise>
      <statement>
        <p>
          Prove that if <m>a,b \in \mathbf{R}</m> and <m>a &lt; b</m> then <m>|(a,b]| = b-a</m> and <m>|[a,b)| = b-a</m>.
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
            Suppose <m>X</m> is a set and <m>A \subseteq X</m>. Show that the collection <m>S = \{\emptyset, A, X\setminus A, X\}</m> is a <m>\sigma</m>-algebra on <m>X</m>.
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Show that <m>S=\left\{\bigcup_{n\in K} (n, n+1): K \subseteq \mathbf{Z}\right\}</m> is a <m>\sigma</m>-algebra on <m>\mathbf{R}</m>.
        </p>

      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Suppose that <m>S</m> is the smallest <m>\sigma</m>-algebra on <m>\mathbf{R}</m> containing <m>\{(r,s]: r,s \in \mathbf{Q}\}</m>. Show that <m>S</m> is the collection of Borel subsets of <m>\mathbf{R}</m>.
        </p>

      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Suppose <m>X</m> is a set and <m>S_1</m> and <m>S_2</m> are <m>\sigma</m>-algebras on <m>X</m>. Let <m>S = \{E \subseteq X: E \in S_1 \text{ or } E \in S_2\}</m>; that is, <m>S</m> is the collection of subsets of <m>X</m> that belong to either <m>S_1</m> or <m>S_2</m>. Is <m>S</m> a sigma algebra? Provide a proof or a counterexample to support your answer.
        </p>

      </statement>
    </exercise>

  </page>
</worksheet>