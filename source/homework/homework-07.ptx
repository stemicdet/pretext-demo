<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Homework 7 (Due October 15)</title>
  <introduction>
    <p>
      <alert>Instructions:</alert> Complete all the exercises below and submit your work by the due date.
    </p>
  </introduction>

  <page>
    <exercise>
      <statement>
        <p>
           Consider the function <m>f</m> on <m>[0,1]</m> defined by
           <md>
            f(x) = \begin{cases} 
                  \hfill  5 \amp \text{ if $x \in \mathbf{Q}$} \\
                  \hfill  6 \hfill \amp \text{ if $x \notin \mathbf{Q}$ and $0 \leq x \leq \frac{1}{3}$} \\
                  \hfill  3 \hfill \amp \text{ if $x \notin \mathbf{Q}$ and $\frac{1}{3} &lt; x \leq 1$} 
              \end{cases}
           </md>
           Let <m>\mu</m> denote Lebesgue measure.
                      Evaluate the integral <m>\displaystyle \int_{0}^{1} f d\mu</m>.
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
           Suppose that <m>(X,S,\mu)</m> is a measure space and <m>f:X \to [0,\infty]</m>
                      is an <m>S</m>-measurable function.
                      Prove that
                      <md>
                        \int f d\mu &gt; 0 \text{ if and only if } \mu(\{x \in X: f(x) &gt; 0\}) &gt; 0
                      </md>
                      
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
        Suppose that <m>f</m> is a Lebesgue Measurable function on <m>[0,1]</m> and that
                there exists a real number <m>M</m> such that <m>f(x) &lt; M</m> almost
                everywhere on <m>[0,1]</m>.
                Prove that
                <md>
                   \int_0^1 f(x) dx &lt; M.
                </md>
                
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Give an example that shows that the Monotone Convergence Theorem can fail if the
                    hypothesis that the sequence <m>\{f_{n}\}</m> consists of non-negative functions
                    is dropped.
        </p>

      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Suppose that <m>f</m> is a non-negative measurable function on <m>\mathbf{R}</m>
                    and <m>\int f d\mu &lt;\infty</m>, where <m>\mu</m> denotes Lebesgue measure.
                    For each <m>k \in \mathbf{N}</m> let
                    <md>
                      f_k(x) = \begin{cases} 
                            \hfill  f(x) \amp \text{ if $x \in [-k,k]$} \\
                            \hfill  0 \hfill \amp \text{ otherwise } 
                        \end{cases}
                    </md>
                 Show that <m>\displaystyle \lim_{k \to \infty}\int f_{k} d\mu = \int f d\mu</m>.   
          </p>
      </statement>
    </exercise>

  </page>
</worksheet>